# Frontend environment. Copy to .env.local and fill in for your deployment.
# NEVER put secrets (DB URIs, JWT keys) in the frontend - it is public code.

# Base URL of the Express API.
# - Local dev: leave empty and let the Vite proxy forward /api to http://127.0.0.1:4000
# - Production (Vercel etc.): full public API origin, e.g. https://api.your-domain.com
VITE_API_BASE_URL=

# Optional: only used by the Vite dev server proxy target.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Application label shown in the sidebar and browser tab.
VITE_APP_NAME=Motorcycle Showroom Management
