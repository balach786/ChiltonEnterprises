# ------------------------------------------------------------------ server -----------
# HTTP port the Express API listens on
PORT=4000
# development | test | production
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------ database ---------
# Local development: mongodb://127.0.0.1:27017
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name used by the application
MONGODB_DB=showroom

# ------------------------------------------------------------------ security ---------
# Long random string. Generate one with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d
# bcrypt cost factor (10-12 is a good production range)
BCRYPT_ROUNDS=10

# ------------------------------------------------------------------ CORS -------------
# Comma separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------ rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# ------------------------------------------------------------------ behaviour --------
# Set to false only when MongoDB is a standalone instance without replica-set support
USE_TRANSACTIONS=true
# Create the initial administrator on first boot when no users exist
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@showroom.local
DEFAULT_ADMIN_PASSWORD=ChangeMe@123

# ------------------------------------------------------------------ uploads ----------
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=5

# Behind a reverse proxy (Render, Railway, Heroku, nginx) set this to 1
TRUST_PROXY=
